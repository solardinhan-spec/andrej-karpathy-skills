# ============================================================
# n8n Gmail 브리핑 - 환경 변수 설정 파일
# 사용법: 이 파일을 복사하여 .env 로 저장 후 값 입력
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# [필수] PostgreSQL 설정
# ------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# 강력한 비밀번호로 변경하세요 (특수문자 포함 16자 이상 권장)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ------------------------------------------------------------
# [필수] n8n 암호화 키
# 자격증명(Credentials)을 암호화하는 키. 반드시 고정값 유지.
# 변경 시 저장된 모든 Credential이 복호화 불가.
# 생성: openssl rand -hex 32
# ------------------------------------------------------------
N8N_ENCRYPTION_KEY=CHANGE_ME_32_HEX_CHARS

# ------------------------------------------------------------
# [선택] n8n 호스트 설정
# 로컬에서만 사용: 기본값 유지
# 외부 접근 시: 실제 도메인 또는 IP 입력
# ------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------
# [선택] 실행 모드
# regular: 단일 인스턴스 (개인 사용에 적합)
# queue: 대용량 처리 (Redis 필요, 고급)
# ------------------------------------------------------------
EXECUTIONS_MODE=regular

# ------------------------------------------------------------
# [AI API 키] - n8n UI Credentials에서 직접 설정 가능
# 여기서 설정하면 환경 변수로 참조할 수 있음
# ------------------------------------------------------------
# OpenAI API 키 (GPT-4o 사용 시)
OPENAI_API_KEY=sk-...

# Anthropic API 키 (Claude 사용 시)
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# [참고] Google OAuth 설정
# n8n UI에서 직접 설정 권장:
#   Settings > Credentials > Add Credential > Google OAuth2 API
# Google Cloud Console에서 OAuth 2.0 클라이언트 생성 필요
# Redirect URI: http://localhost:5678/rest/oauth2-credential/callback
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------
# [참고] 카카오 REST API 키
# 카카오 나에게 보내기 사용 시 필요
# https://developers.kakao.com 에서 발급
# ------------------------------------------------------------
# KAKAO_REST_API_KEY=your_kakao_rest_api_key
# KAKAO_ACCESS_TOKEN=your_kakao_access_token
