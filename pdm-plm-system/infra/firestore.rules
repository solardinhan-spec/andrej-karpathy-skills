rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isDesigner() {
      return isAuthenticated() && getUserRole() in ['admin', 'reviewer', 'designer'];
    }

    function isAnyUser() {
      return isAuthenticated() && getUserRole() in ['admin', 'reviewer', 'designer', 'viewer'];
    }

    // 품목 마스터 (items) - itemCode 유일
    match /items/{itemCode} {
      allow read: if isAnyUser();
      allow create, update: if isDesigner();
      allow delete: if false;
    }

    // 도면 (drawings) - dwgNo 유일키. 상태 전환은 백엔드 트랜잭션 전용
    match /drawings/{dwgNo} {
      allow read: if isAnyUser()
        && (getUserRole() != 'viewer' || resource.data.status == 'Released');
      allow write: if false; // 업로드/제출/승인 모두 백엔드 API 경유

      match /revisions/{rev} {
        allow read: if isAnyUser()
          && (getUserRole() != 'viewer' || resource.data.status == 'Released');
        allow write: if false;
      }
    }

    // BOM 구조 (bom) - itemCode 단위
    match /bom/{bomId} {
      allow read: if isAnyUser();
      allow write: if isDesigner();
      allow delete: if isAdmin();
    }

    // 채번 시퀀스 - 클라이언트 직접 접근 차단
    match /sequences/{seqId} {
      allow read, write: if false;
    }

    // 사용자 프로필 - 관리자 1회 발급(백엔드 서비스 계정 쓰기)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // 감사 로그 - 읽기 전용(관리자), 쓰기는 백엔드 전용
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
