# .env.example - 로컬 개발 환경 설정 참고 (실제 값은 .env.local에 작성)
NODE_ENV=development
PORT=3000

# GCP 프로젝트
PROJECT_ID=pdm-plm-semiconductor
STORAGE_BUCKET=pdm-drawings-semiconductor
FIRESTORE_DATABASE=(default)
REGION=asia-northeast3

# 로컬 개발 시 서비스 계정 키 경로 (.gitignore에 포함된 파일)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Google Drive 백업 폴더 ID (Drive URL에서 마지막 폴더 ID)
DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# CORS 허용 도메인
ALLOWED_ORIGINS=http://localhost:3001,https://pdm.company.com
